# Normalize all text files to LF in the repository and working tree,
# regardless of the contributor's core.autocrlf setting.
* text=auto eol=lf

# Explicit binaries — never touched by line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
